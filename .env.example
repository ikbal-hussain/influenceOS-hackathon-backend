# Copy to .env and adjust (never commit .env)

PORT=3000

# Comma-separated extra origins (merged with localhost + Netlify prod defaults).
# CLIENT_ORIGIN=https://your-preview--app.netlify.app

# Anakin Wire / Holocron (REQUIRED for Anakin Build-a-thon)
# Sign up: https://anakin.io/ — 500 free credits. Docs: https://anakin.io/holocron
ANAKIN_API_KEY=
# Optional. Defaults to https://api.anakin.io/v1
ANAKIN_API_BASE_URL=

# Holocron action ids (defaults: yt_search for both platforms if unset)
# ANAKIN_WIRE_ACTION_ID_YOUTUBE=yt_search
# ANAKIN_WIRE_ACTION_ID_INSTAGRAM=yt_search
# ANAKIN_WIRE_ACTION_ID=
# ANAKIN_WIRE_SEARCH_QUERY=youtube

# Wire task params (optional JSON). Placeholders: {{niche}} {{location}} {{audienceType}} {{query}} {{limit}}
# ANAKIN_WIRE_PARAMS_JSON_YOUTUBE={"query":"{{query}}","maxResults":{{limit}}}
# ANAKIN_WIRE_PARAMS_JSON_INSTAGRAM={"query":"instagram {{niche}} {{location}} influencers","maxResults":{{limit}}}

# Discovery — Wire-first (hackathon defaults)
DISCOVERY_WIRE_REQUIRED=true
DISCOVERY_SEARCH_MODE=wire
DISCOVERY_SEARCH_LIMIT=10
# Skip article URL-scraper when Wire is required (Groq reads Wire JSON instead)
DISCOVERY_ARTICLE_SCRAPE_MAX=0
DISCOVERY_ANAKIN_GENERATE_JSON=false
DISCOVERY_PROFILE_SCRAPE_MAX=0
DISCOVERY_GROQ_REQUIRED=true
# YouTube: Groq curates Wire results; enrich top channels with Wire yt_channel (2nd Holocron call each)
DISCOVERY_YOUTUBE_ENRICH_MAX=8
# Scrape channel page for real subscriber counts after yt_channel (browser scrape)
DISCOVERY_YOUTUBE_SUBSCRIBER_SCRAPE=true

# Groq (https://console.groq.com/) — structures Wire JSON into creator rows (Instagram handles / etc.)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Apify — optional live Instagram profile enrichment on detail page
APIFY_API_TOKEN=

# --- API protection (recommended in production) ---
# DISCOVERY_API_KEY=
# ENRICHMENT_API_KEY=

# Rate limits (per client IP, in-memory; defaults shown)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# DISCOVERY_RATE_LIMIT_WINDOW_MS=60000
# DISCOVERY_RATE_LIMIT_MAX=10
# ENRICHMENT_RATE_LIMIT_WINDOW_MS=60000
# ENRICHMENT_RATE_LIMIT_MAX=15

# TRUST_PROXY_HOPS=1
